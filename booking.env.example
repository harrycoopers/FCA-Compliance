# Add these to your EXISTING website .env / hosting environment.
# Keep all existing session, database, email and Google Sheets settings.
BOOKING_ENABLED=true
BOOKING_PUBLIC_URL=https://009compliance.com
BOOKING_API_KEY=REPLACE_WITH_RANDOM_SHARED_SECRET_AT_LEAST_32_CHARACTERS
# Optional: uses your existing EMAIL_USER and EMAIL_PASS when configured.
# Set false to disable call confirmation emails. On-screen confirmation always works.
BOOKING_CONFIRMATION_EMAIL_ENABLED=true
# Leave empty to use the phone-booking form connected to your private dashboard.
BOOKING_URL=
# Google Meet OAuth settings and BOOKING_TOKEN_KEY are no longer used for bookings.
# Do not remove Google Sheets credentials: the reporting portal still uses those.
