# Optional local settings. Copy this file to .env.local; do not edit production .env.
# npm run dev reads only DB_PATH and PORT from .env.local.
# Relative database paths resolve from the project root. Existing files are reused.
DB_PATH=.local/development/db.sqlite
PORT=3000
# Emails, reminders, Sheets sync and real bookings are always disabled in this mode.
# Do not put production secrets here. .env.local and .local/ are ignored by Git.
