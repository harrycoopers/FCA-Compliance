      <div class="calc<%= c.active ? ' is-festive' : '' %>" data-calc data-step="<%= referral.STEP %>" data-max="<%= referral.MAX_REFERRALS %>" data-monthly="<%= offer.monthlyPayment %>">
        <span class="ribbon-corner<%= c.active ? '' : ' is-hidden' %>" aria-hidden="true"><span></span></span>
        <form class="calc__top" action="/referral#calculator" method="get" data-calc-form>
          <p class="ref-start">£<%= offer.startPayment %> to start, including your first month. Referral discounts apply to subsequent eligible monthly payments.</p><div class="calc__head">
            <div>
              <h2 class="calc__title" id="calc-title">Active qualifying referrals</h2>
              <p class="calc__sub">Each one adds <strong>25%</strong> off eligible authorisation and continuing reporting subscription fees.</p>
            </div>
            <output class="calc__count" for="referralCount" data-calc-count aria-hidden="true"><%= n %></output>
          </div>

          <div class="calc__gifts" aria-hidden="true">
            <% for (let g = 1; g <= referral.MAX_REFERRALS; g++) { %>
              <span class="calc__gift<%= g <= n ? ' is-on' : '' %>" data-gift="<%= g %>">
                <svg viewBox="0 0 40 40" width="40" height="40" fill="none"><g class="calc__lid"><rect x="5" y="12" width="30" height="7" rx="2" fill="currentColor"/><path d="M20 12c-3-6-9-6-9-2.5S20 12 20 12s9 1 9-2.5-6-3.5-9 2.5z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/></g><rect x="7" y="19" width="26" height="16" rx="2" fill="currentColor" opacity=".9"/><rect x="18" y="12" width="4" height="23" fill="#14243A" opacity=".35"/></svg>
                <small><%= g %></small>
              </span>
            <% } %>
          </div>

          <div class="calc__slider">
            <label for="referralCount" class="calc__label">Choose a number of active qualifying referrals (0 to <%= referral.MAX_REFERRALS %>)</label>
            <input type="range" id="referralCount" name="referrals" min="0" max="<%= referral.MAX_REFERRALS %>" step="1" value="<%= n %>"
                   aria-valuetext="<%= n %> active qualifying referral<%= n === 1 ? '' : 's' %>, <%= pct %>% off eligible authorisation and continuing reporting subscription fees"
                   style="--fill:<%= (n / referral.MAX_REFERRALS) * 100 %>%" data-calc-range>
            <ol class="calc__ticks" aria-hidden="true"><% referral.tiers.forEach(function (t) { %><li><%= t.referrals %></li><% }) %></ol>
          </div>
          <button type="submit" class="btn btn--primary btn--sm calc__submit" data-calc-submit>Show discount</button>
        </form>

        <div class="calc__result" data-calc-result>
          <div class="calc__result-row">
            <p class="calc__result-k">Your monthly subscription</p><p class="ref-monthly">£<span data-calc-monthly><%= offer.monthlyPayment * (1 - pct / 100) %></span><small>/month</small></p>
            <p class="calc__pct" aria-hidden="true"><span data-calc-pct><%= pct %></span>%<small> off</small></p>
          </div>
          <div class="calc__meter" aria-hidden="true">
            <% for (let s = 1; s <= referral.MAX_REFERRALS; s++) { %><span class="<%= s <= n ? 'is-on' : '' %>" data-seg="<%= s %>"><%= s * referral.STEP %>%</span><% } %>
          </div>
          <p class="calc__note" data-calc-note><%= resultNote(n) %></p>
          <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-calc-announce><%= calculatorSubmitted ? (n + ' active qualifying referral' + (n === 1 ? '' : 's') + ': ' + pct + '% off eligible authorisation and continuing reporting subscription fees.') : '' %></p>
          <p class="calc__fine">This calculator shows potential savings, not your referral balance. The initial £<%= offer.startPayment %> payment is required at every tier. FCA application fee separate. Your discount continues into reporting support on the same subscription. Each referral must remain subscribed and up to date with payments; if one cancels or stops qualifying, its 25% discount ends from your next invoice.</p>
        </div>
      </div>
