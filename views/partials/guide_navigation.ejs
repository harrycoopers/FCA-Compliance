<div class="guide-menu-label guide-menu-label--<%= navMode %>">
  <a class="guide-menu-label__link" href="/guides"<% if(path === guideNavigation.hub) { %> aria-current="page"<% } %>>Guides</a>
<details class="guide-nav guide-nav--<%= navMode %>" data-guide-nav>
  <summary aria-label="Browse guide categories" aria-controls="<%= navMode %>-guides-panel"><span class="gh__caret" aria-hidden="true">▾</span></summary>
  <div class="guide-nav__panel" id="<%= navMode %>-guides-panel">
    <a class="guide-nav__all" href="<%= guideNavigation.overview %>"<% if(path === guideNavigation.overview) { %> aria-current="page"<% } %>>Motor dealer compliance overview <span aria-hidden="true">→</span></a>
    <div class="guide-nav__groups">
      <% guideNavigation.groups.forEach(group => { %><section aria-labelledby="<%= navMode %>-guides-<%= group.id %>">
        <div class="guide-nav__label" id="<%= navMode %>-guides-<%= group.id %>"><%= group.title %></div>
        <ul><% group.links.forEach(link => { %><li><a href="<%= link.href %>"<% if(path === link.href) { %> aria-current="page"<% } %>><%= link.title %></a></li><% }); %></ul>
      </section><% }); %>
    </div>
  </div>
</details>
</div>
