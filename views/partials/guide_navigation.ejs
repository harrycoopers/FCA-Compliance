<details class="guide-nav guide-nav--<%= navMode %>" data-guide-nav>
  <summary aria-controls="<%= navMode %>-guides-panel">Guides <span class="gh__caret" aria-hidden="true">▾</span></summary>
  <div class="guide-nav__panel" id="<%= navMode %>-guides-panel">
    <a class="guide-nav__all" href="<%= guideNavigation.hub %>"<% if(path === guideNavigation.hub) { %> aria-current="page"<% } %>>View all guides <span aria-hidden="true">→</span></a>
    <div class="guide-nav__groups">
      <% guideNavigation.groups.forEach(group => { %><section aria-labelledby="<%= navMode %>-guides-<%= group.id %>">
        <h2 id="<%= navMode %>-guides-<%= group.id %>"><%= group.title %></h2>
        <ul><% group.links.forEach(link => { %><li><a href="<%= link.href %>"<% if(path === link.href) { %> aria-current="page"<% } %>><%= link.title %></a></li><% }); %></ul>
      </section><% }); %>
    </div>
  </div>
</details>
