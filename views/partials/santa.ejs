<%
  /* Original dancing Santa (decorative). Dances three short beats when it first
     comes into view, then settles into a still pose. aria-hidden, never takes
     clicks, and is static for reduced motion. Param: santaClass. */
  const _cls = (typeof santaClass !== 'undefined' && santaClass) ? santaClass : '';
%>
<div class="santa <%= _cls %>" aria-hidden="true" data-santa>
  <svg viewBox="0 0 140 170" width="140" height="170" focusable="false">
    <ellipse class="santa__shadow" cx="70" cy="163" rx="34" ry="5" fill="#14243A" opacity=".18"/>
    <g class="santa__all">
      <!-- legs -->
      <g class="santa__leg santa__leg--l"><rect x="50" y="122" width="15" height="28" rx="6" fill="#8E1C30"/><path d="M44 148h22a3 3 0 0 1 3 3v3a3 3 0 0 1-3 3H44a6 6 0 0 1 0-9z" fill="#14243A"/></g>
      <g class="santa__leg santa__leg--r"><rect x="75" y="122" width="15" height="28" rx="6" fill="#8E1C30"/><path d="M96 148H74a3 3 0 0 0-3 3v3a3 3 0 0 0 3 3h22a6 6 0 0 0 0-9z" fill="#14243A"/></g>
      <g class="santa__body">
        <!-- arms -->
        <g class="santa__arm santa__arm--l"><path d="M42 86c-12 2-20 10-22 20" stroke="#B3263E" stroke-width="13" stroke-linecap="round" fill="none"/><circle cx="19" cy="109" r="7" fill="#FAFBFD"/><circle cx="18" cy="113" r="6.5" fill="#14243A"/></g>
        <g class="santa__arm santa__arm--r"><path d="M98 86c12-4 20-14 22-26" stroke="#B3263E" stroke-width="13" stroke-linecap="round" fill="none"/><circle cx="120" cy="58" r="7" fill="#FAFBFD"/><circle cx="121" cy="53" r="6.5" fill="#14243A"/></g>
        <!-- coat -->
        <path d="M38 92c0-16 14-24 32-24s32 8 32 24v26c0 7-6 12-13 12H51c-7 0-13-5-13-12z" fill="#B3263E"/>
        <rect x="66" y="74" width="8" height="52" fill="#FAFBFD" opacity=".95"/>
        <rect x="38" y="106" width="64" height="11" fill="#14243A"/>
        <rect x="63" y="104" width="14" height="15" rx="2.5" fill="none" stroke="#E2B65B" stroke-width="3"/>
        <path d="M38 124c10 5 54 5 64 0v2c0 7-6 10-13 10H51c-7 0-13-3-13-10z" fill="#FAFBFD"/>
        <!-- head -->
        <g class="santa__head">
          <circle cx="70" cy="50" r="19" fill="#F4C7A6"/>
          <path d="M48 52c0 20 10 32 22 32s22-12 22-32c-4 6-10 8-22 8s-18-2-22-8z" fill="#FAFBFD"/>
          <path d="M60 60c4-4 16-4 20 0-4 3-16 3-20 0z" fill="#E5F1FC"/>
          <circle cx="63" cy="47" r="2.4" fill="#14243A"/>
          <circle cx="77" cy="47" r="2.4" fill="#14243A"/>
          <circle cx="70" cy="54" r="3.6" fill="#E59A86"/>
          <path d="M57 41q6-4 11 0M72 41q6-4 11 0" stroke="#FAFBFD" stroke-width="3" stroke-linecap="round" fill="none"/>
          <g class="santa__hat">
            <path d="M50 38c2-16 14-24 26-22 10 2 18 10 22 22z" fill="#B3263E"/>
            <path d="M76 17c10-2 22 6 26 18" stroke="#B3263E" stroke-width="9" stroke-linecap="round" fill="none"/>
            <circle class="santa__pom" cx="104" cy="38" r="6.5" fill="#FAFBFD"/>
            <rect x="47" y="34" width="46" height="10" rx="5" fill="#FAFBFD"/>
          </g>
        </g>
      </g>
    </g>
  </svg>
</div>
