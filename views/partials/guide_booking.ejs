<%
  const bookingGroup = typeof guide !== 'undefined' ? guide.group : 'fca';
  const bookingCopy = {
    fca: ['Planning an FCA application?', 'Talk through your application, supporting documents and the administrative assistance available. We can explain the scope and payment terms before you decide.'],
    ccr: ['Preparing your CCR009 return?', 'Talk through the records you need to organise and the administrative support available for your return. Scope and fees are agreed before engagement.'],
    ongoing: ['Organising ongoing compliance?', 'Discuss your dealership’s documentation, record keeping and ongoing administrative support needs. Scope and fees are agreed before work begins.']
  }[bookingGroup];
  const bookingTarget = typeof guideBookingHref !== 'undefined' ? guideBookingHref : '#book-meeting';
%>
  <section class="sec auth-final-cta" aria-labelledby="auth-final-title">
    <div class="wrap">
      <div class="afc-panel">
        <div class="afc-copy">
          <h2 id="auth-final-title"><%= bookingCopy[0] %></h2>
          <p><%= bookingCopy[1] %></p>
          <a class="afc-button" href="<%= bookingTarget %>"><%= typeof guideBookingLabel !== 'undefined' ? guideBookingLabel : 'Book a 15-minute call' %> <span aria-hidden="true">↗</span></a>
          <span class="afc-note">An introductory conversation, not legal or regulatory advice.</span>
        </div>
        <div class="afc-art" aria-hidden="true">
          <div class="afc-orbit"></div>
          <div class="afc-calendar"><div class="afc-binding"><i></i><i></i></div><div class="afc-calendar-top">LET’S TALK</div><strong>15<span>minutes</span></strong><div class="afc-calendar-bottom"><span></span><span></span><span></span><span></span></div></div>
          <div class="afc-check"><svg viewBox="0 0 32 32" fill="none"><path d="m8 16 6 6 11-13" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        </div>
      </div>
    </div>
  </section>

