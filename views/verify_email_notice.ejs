<div class="portal-page"><div class="max-w-lg mx-auto py-12">
<h1 class="text-3xl font-semibold mb-4">Verify your email</h1>
<p class="mb-4">Confirm your email address using the verification link before accessing the dashboard.</p>
<% if (canResend) { %><form method="POST" action="/verify-email/resend">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button type="submit" class="btn btn--primary">Resend verification email</button>
</form><% } %>
<p class="mt-4"><a href="/login">Return to login</a></p>
</div></div>
