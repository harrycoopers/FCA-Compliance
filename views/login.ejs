<div class="auth-page">


<div class="auth-layout">
<div class="auth-intro">
<h1 class="text-2xl font-semibold mb-2 text-slate-50">Log in to your workspace</h1>
<p class="text-sm text-slate-400 mb-6">
    Secure access to your FCA compliance dashboard and monthly reports.
  </p>
</div>
<div class="auth-workspace">
<form action="/login" method="POST" class="space-y-4 bg-slate-900/60 border border-slate-800 rounded-2xl p-4">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div>
      <label for="login-email" class="block text-xs font-medium text-slate-300 mb-1">Work email</label>
      <input id="login-email" type="email" name="email" autocomplete="username" autocapitalize="none" spellcheck="false" required class="w-full rounded-lg bg-slate-950 border border-slate-700 px-3 py-2 text-sm text-slate-50 focus:outline-none focus:ring-2 focus:ring-emerald-500/70" />
    </div>
    <div>
      <label for="login-password" class="block text-xs font-medium text-slate-300 mb-1">Password</label>
      <input id="login-password" type="password" name="password" autocomplete="current-password" required class="w-full rounded-lg bg-slate-950 border border-slate-700 px-3 py-2 text-sm text-slate-50 focus:outline-none focus:ring-2 focus:ring-emerald-500/70" />
    </div>
    <button type="submit" class="w-full mt-2 px-4 py-2 rounded-xl bg-emerald-500 text-slate-950 text-sm font-semibold hover:bg-emerald-400 transition">
      Log in
    </button>
    <div class="flex items-center justify-between mt-2 text-xs text-slate-400">
      <span>Need an account? <a href="/register" class="text-emerald-300 hover:underline">Create one</a></span>
      <a href="/forgot-password" class="hover:text-emerald-300">Forgot password?</a>
    </div>
  </form>
</div>
</div>
<p class="text-sm text-slate-400 mt-3 text-center">
  <a href="/forgot-password" class="text-emerald-300 hover:underline">
    Forgot your password?
  </a>
</p>

</div>
