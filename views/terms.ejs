<link rel="stylesheet" href="<%= assetPath('/css/terms-business.css?v=72') %>">
<div class="legal-page terms-page">
<div class="max-w-4xl mx-auto">
  <div class="mb-4">
    <p class="text-sm uppercase tracking-[0.18em] text-emerald-400 mb-2">Terms and Conditions</p>
    <h1 class="text-3xl font-semibold text-slate-50">Terms of Business (Version 009/13)</h1>
    <p class="text-slate-400 mt-2">
      Website updated 29 October 2026. Effective 1 November 2026. Please read the terms in full.
    </p>
  </div>

  <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-4">
    <div id="termsBox" class="h-[420px] overflow-y-auto rounded-xl border border-slate-800 bg-slate-950 p-4 text-sm text-slate-200 leading-relaxed">
      <%- include('partials/terms_business') %>
    </div>

    <% if (formData) { %>
    <form action="<%= (currentUser ? '/terms/accept' : '/register') %>" method="POST" class="mt-6 space-y-4">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <!-- pass registration fields through -->
      <input type="hidden" name="firm_name" value="<%= formData.firm_name || '' %>">
      <input type="hidden" name="fca_firm_ref" value="<%= formData.fca_firm_ref || '' %>">
      <input type="hidden" name="name" value="<%= formData.name || '' %>">
      <input type="hidden" name="email" value="<%= formData.email || '' %>">
      <input type="hidden" name="mobile_number" value="<%= formData.mobile_number || '' %>">

      <label class="flex items-start gap-3 text-sm text-slate-200">
        <input id="agree" type="checkbox" name="agree_terms" value="yes" class="mt-1" required>
        <span>I have read and agree to the Terms of Business (Version 009/13).</span>
      </label>

      <button
        id="agreeBtn"
        type="submit"
        disabled
        class="w-full px-6 py-3 rounded-xl bg-emerald-500 text-slate-950 font-semibold opacity-50 cursor-not-allowed"
      >
        <%= (currentUser ? 'Agree & Continue' : 'Agree & Create Account') %>
      </button>

      <a href="<%= (currentUser ? '/logout' : '/register') %>" class="block text-center text-sm text-slate-400 hover:text-emerald-300">
  <%= (currentUser ? 'Log out' : 'Go back') %>
</a>
    </form>
    <% } %>
  </div>
</div>

<script>
  // Enable the button only after scrolling to the bottom AND ticking the checkbox
  (function () {
    const box = document.getElementById('termsBox');
    const checkbox = document.getElementById('agree');
    const btn = document.getElementById('agreeBtn');

    if (!checkbox || !btn) return;

    function isAtBottom(el) {
      if (!el) return true;

      // If it doesn't actually scroll (content fits), treat as "at bottom"
      if (el.scrollHeight <= el.clientHeight + 2) return true;

      // Tolerance fixes sub-pixel / mobile browser rounding issues
      const remaining = el.scrollHeight - el.scrollTop - el.clientHeight;
      return remaining <= 3;
    }

    function update() {
      const atBottom = isAtBottom(box);
      const agreed = checkbox.checked;
      const ok = atBottom && agreed;

      btn.disabled = !ok;
      btn.classList.toggle('opacity-50', !ok);
      btn.classList.toggle('cursor-not-allowed', !ok);
      btn.classList.toggle('hover:bg-emerald-400', ok);
    }

    // Some browsers don't reliably fire scroll the way you'd expect
    if (box) {
      box.addEventListener('scroll', update, { passive: true });
      box.addEventListener('touchmove', update, { passive: true });
    }
    checkbox.addEventListener('change', update);

    // Re-check after layout/font changes
    window.addEventListener('load', update);
    window.addEventListener('resize', update);
    setTimeout(update, 250);
    setTimeout(update, 1000);

    update();
  })();
</script>
</div>
