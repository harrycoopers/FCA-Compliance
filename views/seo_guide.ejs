<% if(guide.group==='fca') { %>
<link rel="stylesheet" href="<%= assetPath('/css/guide-original-offers.css') %>">
<% } else { %>
<link rel="stylesheet" href="<%= assetPath('/css/guide-content.css') %>">
<link rel="stylesheet" href="<%= assetPath('/css/auth-final-cta.css') %>">
<% } %>
<div class="ccr009-page ccr009-guide-page researched-guide guide-studio<%= guidePath==='/fca-compliance-motor-dealers-guide'?' guide-studio--hub':'' %>" data-guide-id="<%= guidePath %>"<% if(guide.group==='fca' && campaign.showPrice) { %> data-guide-motion-src="<%= assetPath('/js/guide-original-offers.js') %>"<% } %>>
  <div class="guide-reading-progress" role="progressbar" aria-label="Reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" hidden><span></span></div>
  <section class="ccr009-hero ccr009-guide-hero" aria-labelledby="guide-title">
    <div class="ccr009-hero__inner">
      <div class="ccr009-hero__copy">
        <nav class="guide-breadcrumb" aria-label="Breadcrumb"><ol><% guideBreadcrumbs.forEach((item, index) => { %><li><% if(index === guideBreadcrumbs.length - 1) { %><span aria-current="page"><%= item.name %></span><% } else { %><a href="<%= item.path %>"><%= item.name %></a><% } %></li><% }); %></ol></nav>
        <h1 id="guide-title"><%= guideText(guide.title) %></h1>
        <p class="ccr009-hero__lead guide-answer"><%= guideText(guide.answer) %></p>
        <% if (guide.feeNote && guide.feeNote.inOpening !== false) { %><%- include('partials/guide_fee_note') %><% } %>
        <% if (guide.siblings && guide.siblings.length) { %><ul class="guide-siblings"><% guide.siblings.forEach(item => { %><li>If you need <%= guideText(item.need) %> instead, see <a href="<%= item.href %>"><%= guideText(item.title || guideTitles[item.href]) %></a>.</li><% }); %></ul><% } %>
        <% if (author) { %><p class="guide-byline">Written by <a href="<%= author.url %>"><%= author.name %></a><% if (author.jobTitle) { %>, <%= author.jobTitle %><% } %></p><% } %>
        <p class="guide-reviewed">Published by 009 Compliance · Original sources checked <time datetime="<%= guide.reviewed %>"><%= guideReviewedLabel %></time><% if(guide.modified) { %> · Guide updated <time datetime="<%= guideModified %>"><%= guideModifiedLabel %></time><% } %></p>
        <div class="ccr009-actions"><a class="ccr009-btn ccr009-btn--secondary" href="#guide-sources">View FCA sources</a><a class="ccr009-btn ccr009-btn--secondary" href="#guide-navigation">On this page</a></div>
      </div>
      <div class="ccr009-hero__panel guide-summary"><svg class="guide-document-art" viewBox="0 0 80 80" width="80" height="80" aria-hidden="true" focusable="false"><rect x="9" y="17" width="45" height="55" rx="8" fill="#a8d5f5" opacity=".12" transform="rotate(-8 32 44)"/><rect x="22" y="8" width="45" height="57" rx="8" fill="#e5f1fc"/><path d="M33 24h22M33 33h22M33 42h12" stroke="#40658b" stroke-width="3" stroke-linecap="round"/><circle cx="61" cy="59" r="14" fill="#a8d5f5" stroke="#14243a" stroke-width="3"/><path class="guide-drawn-check" d="m55 59 4 4 8-9" pathLength="1" fill="none" stroke="#14243a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg><div class="ccr009-hero__panel-top"><span>Your guide to</span><strong><%= guide.group === 'ccr' ? 'CCR009 reporting' : guide.group === 'fca' ? 'FCA authorisation' : 'Ongoing compliance' %></strong></div><p>Practical explanations for motor dealers, with official sources and clear next steps.</p><a href="#guide-section-1">Read the guide <span aria-hidden="true">↓</span></a></div>
    </div>
  </section>
  <div class="ccr009-content">
    <div class="ccr009-content__main">
      <% guide.sections.forEach((section, index) => { %>
      <section id="<%= section.id %>" class="ccr009-section<%= /example/i.test(section.title)?' guide-example':'' %>" aria-labelledby="<%= section.id %>-title">
        <h2 class="services-h2" id="<%= section.id %>-title"><%= guideText(section.title) %></h2>
        <% section.paragraphs.forEach((p, pi) => { %><p class="services-p"><% guideParagraphParts(section.id, pi, p).forEach(part => { %><% if(part.href) { %><a class="guide-context-link" href="<%= part.href %>"><%= guideText(part.text) %></a><% } else { %><%= guideText(part.text) %><% } %><% }); %></p><% }); %>
        <% if (section.rows.length) { %>
        <div class="guide-table-wrap" role="region" aria-label="<%= section.title %> table" tabindex="0"><table class="guide-table"><caption><%= guideText(section.title) %></caption><thead><tr><% section.columns.forEach(col => { %><th scope="col"><%= guideText(col) %></th><% }); %></tr></thead><tbody><% section.rows.forEach(row => { %><tr><% row.forEach((cell, ci) => { %><% if(ci === 0) { %><th scope="row"><%= guideText(cell) %></th><% } else { %><td><%= guideText(cell) %></td><% } %><% }); %></tr><% }); %></tbody></table></div>
        <% } %>
        <% if (section.bullets.length) { %><ul class="services-bullets ccr009-bullets"><% section.bullets.forEach(item => { %><li><%= guideText(item) %></li><% }); %></ul><% } %>
        <% if (section.feeNote && guide.feeNote) { %><%- include('partials/guide_fee_note') %><% } %>
        <% if (section.links.length) { %><ul class="guide-links"><% section.links.forEach(link => { %><li><a href="<%= link[0] %>"><%= guideText(link[1]) %> <span aria-hidden="true">→</span></a></li><% }); %></ul><% } %>
        <% if (section.sources.length) { %><p class="guide-section-sources">Official sources: <% section.sources.forEach((source, si) => { %><% if(si) { %> · <% } %><a href="<%= source.href %>"><%= guideText(source.label) %></a><% }); %></p><% } %>
      </section>
      <% if(index === 0 && guideOfferBanner) { %><%- include('partials/guide_offer_banner') %><% } %>
      <% if(index === guide.sections.length - 1 && guide.group === 'ccr') { %><%- include('partials/guide_reporting_offer') %><% } %>
      <% if(index === guide.sections.length - 1 && guide.group === 'ongoing') { %><%- include('partials/guide_ongoing_offer') %><% } %>
      <% }); %>
      <section class="ccr009-section ccr009-faq" id="guide-faq" aria-labelledby="guide-faq-title"><h2 class="services-h2" id="guide-faq-title">Frequently asked questions</h2><% guideFaqs.forEach(faq => { %><details class="ccr009-faq__item"><summary><%= faq.question %></summary><p class="services-p"><%= faq.answer %></p><% if (faq.feeNote && guide.feeNote) { %><%- include('partials/guide_fee_note') %><% } %></details><% }); %></section>
      <section class="ccr009-section guide-source-list" id="guide-sources" aria-labelledby="guide-sources-title"><h2 class="services-h2" id="guide-sources-title">Sources and scope</h2><p class="services-p">The original regulatory explanations were checked on <%= guideReviewedLabel %>.<% if(guide.updateSummary) { %> <%= guideText(guide.updateSummary) %><% } %> Suggested checklists and fictional examples are identified separately. Requirements depend on the firm and activity; check the current rules and your firm’s actual permissions and schedule.</p><ul class="guide-links"><% guide.sources.forEach(source => { %><li><a href="<%= source.href %>"><%= guideText(source.label) %></a></li><% }); %></ul><p class="services-p">009 Compliance provides administrative assistance, not legal or regulatory advice. The applicant or authorised firm remains responsible for its information, activities and obligations. The FCA makes authorisation decisions.</p></section>
      <section class="ccr009-section" id="related-guides" aria-labelledby="related-title"><div class="services-h2" id="related-title">Continue with a related guide</div><ul class="guide-links"><% guide.related.forEach(url => { %><li><a href="<%= url %>"><%= guideText(guideTitles[url]) %> <span aria-hidden="true">→</span></a></li><% }); %></ul></section>
      <% if (guide.group === 'fca') { %><%- include('partials/guide_original_offers') %><% } %>
    </div>
    <aside class="ccr009-aside" aria-label="Guide navigation"><nav class="ccr009-aside__card" id="guide-navigation" aria-label="On this page"><details class="guide-toc"><summary><span class="guide-label">On this page</span></summary><ul class="guide-links"><% guide.sections.forEach(section => { %><li><a href="#<%= section.id %>"><%= guideText(section.title) %></a></li><% }); %><li><a href="#guide-faq">Frequently asked questions</a></li><li><a href="#guide-sources">Sources and scope</a></li></ul></details></nav><div class="ccr009-aside__card guide-support"><div class="guide-label"><%= guide.group === 'ccr' ? 'Help with your CCR009 return' : guide.group === 'fca' ? 'Help with your FCA application' : 'Support for your dealership' %></div><p><%= guide.group === 'ccr' ? 'Get administrative help organising the information and preparing your return.' : guide.group === 'fca' ? 'Practical assistance with your application and supporting documents.' : 'Organise your ongoing compliance administration with practical support.' %></p><a href="<%= guide.group === 'ccr' ? '/ccr009-return-assistance-motor-dealers' : guide.group === 'fca' ? '/fca-authorisation-motor-dealers' : '/motor-dealer-compliance' %>"><%= guide.group === 'ccr' ? 'Explore CCR009 return assistance' : guide.group === 'fca' ? guideOfferAnchor.charAt(0).toUpperCase() + guideOfferAnchor.slice(1) : 'Explore ongoing compliance support' %> <span aria-hidden="true">→</span></a></div></aside>
  </div>
  <%- include('partials/guide_booking') %>
</div>
<script defer src="<%= assetPath('/js/auth-final-cta.js') %>"></script>
<script defer src="<%= assetPath('/js/guide-enhancements.js') %>"></script>
