<%
  const tick = '<svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 6.2 5 8.5l4.5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  const c = campaign;
  /* Shared client testimonials; wording and existing order are preserved. */
  const reviews = testimonials.reviews;
  const excerptSegments = (text, phrases) => {
    const ranges = phrases.map(phrase => ({ start: text.indexOf(phrase), text: phrase }))
      .filter(range => range.start >= 0).sort((a, b) => a.start - b.start);
    const segments = []; let position = 0;
    ranges.forEach(range => {
      if (range.start < position) return;
      segments.push({ text: text.slice(position, range.start), highlighted: false });
      segments.push({ text: range.text, highlighted: true });
      position = range.start + range.text.length;
    });
    segments.push({ text: text.slice(position), highlighted: false });
    return segments;
  };
  // Splits the attribution into display lines; the lines concatenate back to the exact original.
  const attributionLines = (attribution) => {
    const nameEnd = attribution.indexOf(',');
    const paren = attribution.indexOf(' (');
    const special = paren > -1;
    const roleEnd = special ? paren : attribution.indexOf(',', nameEnd + 1);
    const lastComma = attribution.lastIndexOf(',');
    const locationStart = lastComma > roleEnd ? lastComma + 1 : attribution.length;
    const roleStop = roleEnd + (special ? 0 : 1);
    return {
      name: attribution.slice(0, nameEnd + 1),
      role: attribution.slice(nameEnd + 1, roleStop),
      business: attribution.slice(roleStop, locationStart),
      location: attribution.slice(locationStart)
    };
  };
