  <!-- 4. Existing testimonial carousel (v7 behaviour, unchanged) -->
  <section class="sec sec--flush-top" aria-labelledby="testimonials-heading">
    <div class="wrap">
      <div class="proof" data-testimonials aria-roledescription="carousel" aria-labelledby="testimonials-heading">
        <div class="proof__head">
          <div>
            
            <h2 class="display-m" id="testimonials-heading">What motor dealers say about <span class="serif">working with us.</span></h2><p style="margin-top:16px"><a class="text-link" href="/testimonials">Read all client testimonials <span aria-hidden="true">→</span></a></p>
          </div>
          <div class="testimonial-controls" data-carousel-controls hidden>
            <div class="testimonial-control-buttons">
              <button type="button" class="carousel-control" data-carousel-prev aria-label="Previous testimonial" aria-controls="testimonial-stage"><span aria-hidden="true">←</span></button>
              <button type="button" class="carousel-control" data-carousel-next aria-label="Next testimonial" aria-controls="testimonial-stage"><span aria-hidden="true">→</span></button>
            </div>
          </div>
        </div>
        <div id="testimonial-stage" class="testimonial-stage" data-carousel-stage aria-live="off">
          <% reviews.forEach((review, index) => { const lines = attributionLines(review.attribution); %>
            <article class="testimonial-card" data-review-index="<%= index %>" role="group" aria-roledescription="slide" aria-label="Testimonial <%= index + 1 %> of <%= reviews.length %>">
              <header class="testimonial-person">
                <p class="testimonial-person-lines"><strong class="testimonial-name"><%= lines.name %></strong><span class="testimonial-role"><%= lines.role %></span><span class="testimonial-business"><%= lines.business %></span><span class="testimonial-location"><%= lines.location %></span></p>
                <p class="sales-sr-only" data-attribution aria-hidden="true"><%= review.attribution %></p>
              </header>
              <blockquote class="testimonial-excerpt"><p><% excerptSegments(review.excerpt, review.highlights).forEach(segment => { %><% if (segment.highlighted) { %><strong class="testimonial-highlight"><%= segment.text %></strong><% } else { %><%= segment.text %><% } %><% }); %></p></blockquote>
              <details class="testimonial-details" data-full-review>
                <summary>Read full review</summary>
                <div class="testimonial-full" data-full-text>
                  <% review.paragraphs.forEach(paragraph => { %><p><%= paragraph %></p><% }) %>
                </div>
              </details>
            </article>
          <% }) %>
        </div>
        <p class="sales-sr-only" data-carousel-announcement aria-live="polite" aria-atomic="true"></p>
        <dialog class="testimonial-dialog" data-review-dialog aria-labelledby="review-dialog-title">
          <div class="testimonial-dialog-top"><button type="button" class="carousel-control" data-review-close aria-label="Close full review">✕</button></div>
          <h3 id="review-dialog-title">Full review</h3>
          <blockquote data-dialog-quote></blockquote>
          <p class="testimonial-attribution" data-dialog-attribution></p>
        </dialog>
      </div>
    </div>
  </section>

