  const reviews = testimonials.applicationReviewIndexes.map(i => testimonials.reviews[i]);
  const excerptSegments = (text, phrases) => {
    const ranges = phrases.map(phrase => ({ start: text.indexOf(phrase), text: phrase }))
      .filter(range => range.start >= 0).sort((a, b) => a.start - b.start);
    const segments = []; let position = 0;
    ranges.forEach(range => {
      if (range.start < position) return;
      segments.push({ text: text.slice(position, range.start), highlighted: false });
      segments.push({ text: range.text, highlighted: true });
      position = range.start + range.text.length;
    });
    segments.push({ text: text.slice(position), highlighted: false });
    return segments;
  };
  const attributionLines = (attribution) => {
    const nameEnd = attribution.indexOf(',');
    const paren = attribution.indexOf(' (');
    const special = paren > -1;
    const roleEnd = special ? paren : attribution.indexOf(',', nameEnd + 1);
    const locationStart = attribution.lastIndexOf(',') + 1;
    const roleStop = roleEnd + (special ? 0 : 1);
    return { name: attribution.slice(0, nameEnd + 1), role: attribution.slice(nameEnd + 1, roleStop), business: attribution.slice(roleStop, locationStart), location: attribution.slice(locationStart) };
  };
