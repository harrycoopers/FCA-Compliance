<%
const highlightReview = (text, phrases) => {
  const ranges = [];
  (phrases || []).forEach(phrase => {
    if (!phrase) return;
    let start = text.indexOf(phrase);
    while (start !== -1) { ranges.push({start, end:start+phrase.length}); start=text.indexOf(phrase,start+phrase.length); }
  });
  ranges.sort((a,b)=>a.start-b.start || b.end-a.end);
  const segments=[];let position=0;
  ranges.forEach(range=>{if(range.start<position)return;segments.push({text:text.slice(position,range.start),highlight:false});segments.push({text:text.slice(range.start,range.end),highlight:true});position=range.end;});
  segments.push({text:text.slice(position),highlight:false});return segments;
};
%>
<link rel="stylesheet" href="<%= assetPath('/css/testimonials-page.css?v=52') %>">
<script defer src="<%= assetPath('/js/testimonials-page.js') %>"></script>
<div class="reviews-page">
<section class="sec reviews-hero"><div class="wrap"><a class="text-link" href="/">← Back to home</a><div class="reviews-hero__grid"><div><h1 class="display-xl">Their dealerships.<br><span class="serif">Their words.</span></h1><p class="lede">Hear from the people we support with FCA authorisation, reporting and ongoing compliance.</p><a class="btn btn--primary btn--sheen" href="/contact#book-meeting">See if we’re the right fit <span aria-hidden="true">→</span></a><a class="text-link reviews-jump" href="#client-reviews">Read their experiences ↓</a></div><figure class="reviews-feature"><span class="reviews-feature__mark" aria-hidden="true">“</span><blockquote>The team there are <strong>super-efficient, knowledgeable</strong> and we simply <strong>wouldn’t use any other company.</strong></blockquote><figcaption>Andy, Manager, S Cars Limited, Shaw</figcaption><span class="reviews-feature__line" aria-hidden="true"></span></figure></div></div></section>
<section class="sec sec--flush-top" id="client-reviews" aria-labelledby="client-reviews-title"><div class="wrap"><div class="sec-head"><h2 class="display-l" id="client-reviews-title">Good people.<br><span class="serif">Lasting relationships.</span></h2><p>From first applications to ongoing support, read each client’s full experience below.</p></div><div class="reviews-wall">
<% testimonials.reviews.forEach((review, index) => { %>
<article class="review-story" data-review-story><div class="review-story__top"><span class="review-avatar" aria-hidden="true"><%= review.attribution.trim().charAt(0) %></span><h3><%= review.attribution %></h3><span class="review-story__quote" aria-hidden="true">“</span></div><blockquote><% review.paragraphs.forEach(paragraph => { %><p><% highlightReview(paragraph, review.highlights).forEach(segment => { %><% if (segment.highlight) { %><strong class="review-keyphrase"><%= segment.text %></strong><% } else { %><%= segment.text %><% } %><% }) %></p><% }) %></blockquote></article>
<% }) %>
</div></div></section>
<section class="sec sec--flush-top"><div class="wrap"><div class="reviews-invite"><h2 class="display-l">Your next step.<br><span class="serif">A conversation.</span></h2><div><p>Tell us about your dealership and find out how our support could fit.</p><a class="btn btn--primary btn--sheen" href="/contact#book-meeting">Book a 15-minute call →</a><a class="text-link" href="/contact#send-message">Prefer to send a message?</a></div></div></div></section>
</div>
