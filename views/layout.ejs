<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <title><%= (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : '009 Compliance | FCA Authorisation Assistance for Motor Dealers' %></title>

<meta name="description" content="<%= (typeof pageDescription !== 'undefined' && pageDescription) ? pageDescription : 'Monthly FCA compliance reporting portal for motor dealers. Submit MI, track submissions, and maintain evidence-ready records with 009 Compliance.' %>">

<% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %><link rel="canonical" href="<%= canonicalUrl %>"><% } %>

<meta name="robots" content="<%= (typeof robots !== 'undefined' && robots) ? robots : 'index,follow' %>">
<meta property="og:title" content="<%= (typeof ogTitle !== 'undefined' && ogTitle) ? ogTitle : ((typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : '009 Compliance | FCA Compliance Reporting Portal') %>">
<meta property="og:description" content="<%= (typeof ogDescription !== 'undefined' && ogDescription) ? ogDescription : ((typeof pageDescription !== 'undefined' && pageDescription) ? pageDescription : 'Monthly FCA compliance reporting portal for motor dealers. Submit MI, track submissions, and maintain evidence-ready records with 009 Compliance.') %>">
<meta property="og:type" content="<%= (typeof ogType !== 'undefined' && ogType) ? ogType : 'website' %>">
<meta property="og:url" content="<%= (typeof canonicalUrl !== 'undefined' && canonicalUrl) ? canonicalUrl : '' %>">
<meta property="og:site_name" content="009 Compliance">
<meta property="og:locale" content="en_GB">
<meta property="og:image" content="<%= (typeof ogImage !== 'undefined' && ogImage) ? ogImage : 'https://009compliance.com/images/logo1resized.png' %>">
<meta property="og:image:width" content="512">
<meta property="og:image:height" content="512">
<meta property="og:image:alt" content="009 Compliance logo">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="<%= (typeof ogTitle !== 'undefined' && ogTitle) ? ogTitle : ((typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : '009 Compliance | FCA Compliance Reporting Portal') %>">
<meta name="twitter:description" content="<%= (typeof ogDescription !== 'undefined' && ogDescription) ? ogDescription : ((typeof pageDescription !== 'undefined' && pageDescription) ? pageDescription : 'Monthly FCA compliance reporting portal for motor dealers. Submit MI, track submissions, and maintain evidence-ready records with 009 Compliance.') %>">
<meta name="twitter:image" content="<%= (typeof ogImage !== 'undefined' && ogImage) ? ogImage : 'https://009compliance.com/images/logo1resized.png' %>">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

<!-- Schema.org Organization -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://009compliance.com/#organization",
  "name": "009 Compliance",
  "legalName": "009 Compliance Ltd",
  "url": "https://009compliance.com",
  "logo": "https://009compliance.com/images/logo1resized.png",
  "email": "info@009compliance.com",
  "telephone": "03300432377",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Hilton Jones Hollinwood Business Centre, Albert Street",
    "addressLocality": "Oldham",
    "postalCode": "OL8 3QL",
    "addressCountry": "GB"
  }
}
</script>

<% if (typeof pageSchema !== 'undefined' && pageSchema) { %>
  <% (Array.isArray(pageSchema) ? pageSchema : [pageSchema]).forEach((schemaItem) => { %>
<script type="application/ld+json">
<%- jsonLd(schemaItem) %>
</script>
  <% }) %>
<% } %>

  <meta name="csrf-token" content="<%= csrfToken %>">
  <% if (!sensitivePage) { %>
  <!-- Google tag (gtag.js) -->
   <script async src="https://www.googletagmanager.com/gtag/js?id=G-BMQFTHWWKP"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-BMQFTHWWKP');
</script>
  <% } %>

  <!-- FAVICONS: light & dark mode -->
   <link rel="icon" type="image/png" href="/logo-dark.png" media="(prefers-color-scheme: light)">
   <link rel="icon" type="image/png" href="/logo-light.png" media="(prefers-color-scheme: dark)">
   <link rel="apple-touch-icon" href="/logo-dark.png">

  <!-- Tailwind utilities are still used by the client portal and legal pages. -->
  <link rel="preload" href="/fonts/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/figtree-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="<%= assetPath('/css/styles.css') %>" />
  <link rel="stylesheet" href="<%= assetPath('/css/redesign.css') %>" />
  <link rel="stylesheet" href="<%= assetPath('/css/site.css') %>" />
  <link rel="stylesheet" href="<%= assetPath('/css/campaign.css') %>" />
  <!-- Match the original CDN insertion order, using compiled local CSS. -->
  <link rel="stylesheet" href="<%= assetPath('/css/tailwind.css') %>" />
</head>

<% const isSales = typeof salesPage !== 'undefined' && salesPage;
   const path = typeof currentPath !== 'undefined' ? currentPath : '';
   const meetingHref = (typeof inPageMeeting !== 'undefined' && inPageMeeting) ? '#book-meeting' : '/contact#book-meeting';
   const festive = isSales && campaign.active;
   const navActive = (href) => (path === href || (href !== '/' && path.indexOf(href) === 0)) ? ' aria-current="page"' : ''; %>
<body class="nine-site site-v8 site-v9 <%= isSales ? 'is-sales-page' : 'is-app-page' %><%= festive ? ' is-festive' : '' %> min-h-screen flex flex-col">
<a class="skip-link" href="#main-content">Skip to main content</a>
<header class="gh" data-site-header>
  <div class="gh__bar">
    <a href="/" class="brand" aria-label="009 Compliance home">
      <img src="/images/logo1resized.png" alt="009 Compliance" width="512" height="512" fetchpriority="high" />
      <span class="brand__text">
        <span class="brand__name">009 Compliance</span>
        <span class="brand__tag">FCA support for motor dealers</span>
      </span>
    </a>

    <nav class="gh__nav" aria-label="Main">
      <div class="gh__menu">
        <a href="/services" aria-haspopup="true"<%- (['/services','/fca-authorisation-motor-dealers','/ccr009-return-assistance-motor-dealers','/motor-dealer-compliance','/motor-finance-for-dealerships'].includes(path) ? ' aria-current="page"' : '') %>>Services <span aria-hidden="true" class="gh__caret">▾</span></a>
        <div class="gh__dropdown">
          <div>
            <a href="/fca-authorisation-motor-dealers"><strong>FCA Authorisation Assistance</strong><span><%= campaign.showPrice ? '£' + offer.startPayment + ' to get started, then £' + offer.monthlyPayment + ' a month' : 'Application support for motor dealers' %></span></a>
            <a href="/ccr009-return-assistance-motor-dealers"><strong>CCR009 Return Assistance</strong><span>Organised annual reporting preparation</span></a>
            <a href="/motor-dealer-compliance"><strong>Ongoing Compliance Support</strong><span>Practical help after authorisation</span></a>
            <a href="/motor-finance-for-dealerships"><strong>Motor Finance for Dealerships</strong><span>Explore customer finance with broker support</span></a>
            <a href="/services" class="gh__all">All services →</a>
          </div>
        </div>
      </div>
      <a href="/pricing"<%- navActive('/pricing') %>>Pricing</a>
      <a href="/testimonials"<%- navActive('/testimonials') %>>Testimonials</a>
      <a href="/about"<%- navActive('/about') %>>About</a>
      <a href="/referral"<%- navActive('/referral') %>>Referrals</a>
      <a href="/contact"<%- navActive('/contact') %>>Contact</a>
    </nav>

    <div class="gh__actions">
      <% if (currentUser) { %>
        <a href="/dashboard" class="gh__quiet">Dashboard</a>
        <a href="/logout" class="gh__quiet">Log out</a>
      <% } else { %>
        <a href="/login" class="gh__quiet">Client login</a>
      <% } %>
      <a href="<%= meetingHref %>" class="btn btn--primary btn--sm" data-meeting-cta>Book a 15-minute call</a>
    </div>

    <button id="mobileMenuBtn" aria-controls="mobileMenu" aria-expanded="false" class="gh__burger" aria-label="Open menu" type="button">
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
  </div>

  <div id="mobileMenu" class="gh__mobile" hidden>
    <nav aria-label="Mobile">
      <a href="/services">All services</a>
      <a href="/fca-authorisation-motor-dealers">FCA authorisation assistance</a>
      <a href="/ccr009-return-assistance-motor-dealers">CCR009 return assistance</a>
      <a href="/motor-dealer-compliance">Ongoing compliance support</a>
      <a href="/motor-finance-for-dealerships">Motor finance for dealerships</a>
      <a href="/pricing">Pricing</a>
      <a href="/testimonials">Testimonials</a>
      <a href="/about">About</a>
      <a href="/referral">Referral programme</a>
      <a href="/contact">Contact</a>
      <div class="gh__mobile-auth">
        <% if (currentUser) { %>
          <a href="/dashboard">Dashboard</a>
          <a href="/logout">Log out</a>
        <% } else { %>
          <a href="/login">Client login</a>
          <a href="/register">Register for the client portal</a>
        <% } %>
      </div>
      <a href="<%= meetingHref %>" class="btn btn--primary btn--block">Book a 15-minute call</a>
    </nav>
  </div>
</header>

<main id="main-content" class="site-main flex-1" tabindex="-1">
  <% if ((success && success.length) || (error && error.length)) { %>
    <div class="site-flash-wrap">
      <% if (success && success.length) { %>
        <div class="site-flash site-flash--success site-success" role="status"><%= success[0] %></div>
      <% } %>
      <% if (error && error.length) { %>
        <div class="site-flash site-flash--error" role="alert"><%= error[0] %></div>
      <% } %>
    </div>
  <% } %>

  <% if (isSales) { %>
    <%- body %>
  <% } else { %>
    <div class="site-container">
      <%- body %>
    </div>
  <% } %>
</main>

<footer class="gf">
  <div class="gf__inner">
    <div class="gf__brand">
      <a href="/" class="brand brand--footer">
        <img src="/images/logo1resized.png" alt="009 Compliance" width="512" height="512" loading="lazy" />
        <span class="brand__text"><span class="brand__name">009 Compliance</span><span class="brand__tag">FCA support for motor dealers</span></span>
      </a>
      <p>Practical, plain-English FCA authorisation and compliance support from people who understand the motor trade.</p>
      <a href="<%= meetingHref %>" class="btn btn--primary btn--sm">Book a 15-minute call</a>
    </div>
    <nav class="gf__col" aria-label="Services">
      <h2>Services</h2>
      <a href="/fca-authorisation-motor-dealers">FCA Authorisation for Motor Dealers</a>
      <a href="/ccr009-return-assistance-motor-dealers">CCR009 Return Assistance</a>
      <a href="/motor-dealer-compliance">Motor Dealer Compliance Support</a>
      <a href="/motor-finance-for-dealerships">Motor Finance for Dealerships</a>
      <a href="/pricing">Pricing</a>
      <a href="/referral">Referral programme</a>
      <a href="/services">All services</a>
    </nav>
    <nav class="gf__col" aria-label="Guides">
      <h2>Guides</h2>
      <a href="/do-motor-dealers-need-fca-authorisation">Do motor dealers need FCA authorisation?</a>
      <a href="/fca-application-documents-motor-dealers">FCA application documents</a>
      <a href="/limited-permission-fca-authorisation-motor-dealers">Limited permission authorisation</a>
      <a href="/what-is-ccr009">What is CCR009?</a>
      <a href="/consumer-duty-motor-dealers">Consumer Duty for motor dealers</a>
    </nav>
    <div class="gf__col">
      <h2>Contact</h2>
      <a href="mailto:info@009compliance.com">info@009compliance.com</a>
      <a href="tel:03300432377">03300432377</a>
      <p>C/O Hilton Jones Hollinwood Business Centre, Albert Street, OL8 3QL, Oldham</p>
      <p>Monday–Friday: 8:30AM - 6:30PM</p>
      <% if (currentUser) { %>
        <a href="/dashboard">Client dashboard</a>
      <% } else { %>
        <a href="/login">Client login</a>
        <a href="/register">Client portal registration</a>
      <% } %>
    </div>
  </div>
  <div class="gf__legal">
    <div class="gf__legal-inner">
      <p>© <%= new Date().getFullYear() %> Main Mission Media, 009 Compliance. All rights reserved.</p>
      <p>009 Compliance Ltd is a company registered in England and Wales (company number 16910484). ICO Number - ZC072139</p>
      <nav aria-label="Legal">
        <a href="/terms">Terms and Conditions</a>
      <a href="/privacy-policy">Privacy Policy</a>
        <a href="/complaints-policy">Complaints Policy</a>
        <a href="/cookie-policy">Cookies</a>
      </nav>
    </div>
  </div>
</footer>

<% if (isSales && !(typeof hideStickyCta !== 'undefined' && hideStickyCta)) { %>
  <div class="mobile-cta-bar" data-mobile-cta aria-hidden="true" inert>
    <a href="<%= meetingHref %>" class="btn btn--primary btn--block">Book a 15-minute call</a>
  </div>
<% } %>

<div id="success-toast"
     class="fixed top-6 right-6 z-50 hidden max-w-sm rounded-xl border border-emerald-500/40 bg-emerald-500/10 px-5 py-4 text-sm text-emerald-200 shadow-lg backdrop-blur">
  <div class="flex items-start gap-3">
    <div class="mt-0.5 text-emerald-400">✔</div>
    <div>
      <p class="font-semibold text-emerald-300">Monthly Submission Complete</p>
      <p id="success-toast-message" class="text-emerald-200/90">
        <!-- JS will fill this -->
      </p>
    </div>
  </div>
</div>

<script>
  <% if (locals.showSubmissionToast && locals.showSubmissionToast[0] === "true") { %>
    window.__TOAST_SUCCESS__ = "You have successfully completed a Monthly Submission Form!";
  <% } %>
</script>
  <script defer src="<%= assetPath('/js/main.js') %>"></script>
  <script defer src="<%= assetPath('/js/site.js') %>"></script>
  <% if (isSales || /data-(campaign-bar|offer-countdown|santa|road|ladder|calc|growing-reward|referral-steps)\b/.test(body)) { %>
  <script defer src="<%= assetPath('/js/campaign.js?v=75') %>"></script>
  <% } %>
  <% if (body.includes('data-christmas-arrival')) { %>
  <script defer src="<%= assetPath('/js/christmas-arrival.js') %>"></script>
  <% } %>
</body>
</html>
