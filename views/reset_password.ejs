<div class="auth-page">
<div class="auth-layout">
<div class="auth-intro">
<h1 class="text-2xl font-semibold text-slate-50 mb-4">Set a new password</h1>
<% if (error && error.length) { %><div role="alert" class="mb-4 bg-red-100 text-red-700 px-4 py-3 rounded-lg">
      <%= error[0] %>
    </div><% } %>
<% if (success && success.length) { %><div role="status" class="mb-4 bg-emerald-100 text-emerald-700 px-4 py-3 rounded-lg">
    <%= success[0] %>
  </div><% } %>
</div>
<div class="auth-workspace">
<form method="POST" action="/reset-password/<%= token %>" class="space-y-4">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="field-password">New password</label>
<input
      id="field-password" autocomplete="new-password" type="password"
      name="password"
      placeholder="New password"
      required
      minlength="12" maxlength="72"
      class="w-full h-[52px] rounded-lg bg-slate-950 border border-slate-700 px-4 text-slate-50"
    />

    <label for="field-confirmPassword">Confirm password</label>
<input
      id="field-confirmPassword" autocomplete="new-password" type="password"
      name="confirmPassword"
      placeholder="Confirm password"
      required
      minlength="12" maxlength="72"
      class="w-full h-[52px] rounded-lg bg-slate-950 border border-slate-700 px-4 text-slate-50"
    />

    <button class="w-full py-3 rounded-xl bg-emerald-500 text-slate-950 font-semibold">
      Reset password
    </button>
  </form>
</div>
</div>

</div>
